    <string name="onboarding_step">Step %1$d of %2$d</string>
    <string name="onboarding_title_0">Welcome to WiFiChat Mesh</string>
    <string name="onboarding_body_0">Message people nearby without mobile data, internet, or an account. Messages can hop through other devices to reach someone you are not directly connected to. No email, phone number, or cloud login is required.</string>
    <string name="onboarding_title_1">Choose a display name</string>
    <string name="onboarding_body_1">This is how nearby people will see you. You can change it later in Settings. Your device identity is generated locally and is never based on your hardware address.</string>
    <string name="onboarding_title_2">Nearby device permissions</string>
    <string name="onboarding_body_2">To find and connect to nearby phones, the app needs Bluetooth scan, connect, and advertise permissions. On older Android versions it also needs location permission, which the system requires for Bluetooth discovery. Nothing is ever sent to a server.</string>
    <string name="onboarding_title_3">Start discovery</string>
    <string name="onboarding_body_3">Discovery is how you find other people running WiFiChat Mesh. You can stop it any time. The status shown is always the real state of your radio.</string>
